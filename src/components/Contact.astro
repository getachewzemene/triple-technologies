---
import { site, services } from '../data/site';
import { amharicServices, messages, type Language } from '../data/locales';
interface Props { language?: Language; }
const { language = 'en' } = Astro.props;
const copy = messages[language];
const serviceList = language === 'am' ? amharicServices : services;
const { email, phone, telegram, whatsapp } = site.contact;
const channels = [
  email && { label: copy.emailLabel, text: email, href: `mailto:${email}` },
  phone && { label: copy.phoneLabel, text: phone, href: `tel:${phone.replace(/\s+/g, '')}` },
  telegram && { label: copy.telegramLabel, text: copy.telegramText, href: telegram },
  whatsapp && { label: copy.whatsappLabel, text: copy.whatsappText, href: whatsapp },
].filter(Boolean);
---
<section class="contact on-ink" id="contact" aria-labelledby="contact-title">
  <div class="container layout">
    <div class="pitch">
      <p class="eyebrow">Need a practical fix?</p>
      <h2 id="contact-title">{copy.contactTitle}</h2>
      <p>{copy.contactIntro}</p>

      {channels.length > 0 && (
        <dl class="channels">
          {channels.map((c: any) => (
            <div>
              <dt>{c.label}</dt>
              <dd><a href={c.href}>{c.text}</a></dd>
            </div>
          ))}
        </dl>
      )}
    </div>

    <form
      class="form"
      id="contact-form"
      method="post"
      novalidate
      data-endpoint={site.formEndpoint}
      data-email={email}
      data-site={site.name}
      data-language={language}
      data-required-error={copy.requiredError}
      data-sent-success={copy.sentSuccess}
      data-sent-failure={copy.sentFailure}
      data-email-app-message={copy.emailAppMessage}
      data-email-subject={copy.emailSubject}
      data-form-not-connected={copy.formNotConnected}
    >
      <div class="field">
        <label for="f-name">{copy.nameLabel}</label>
        <input id="f-name" name="name" type="text" autocomplete="name" required />
      </div>
      <div class="field">
        <label for="f-reach">{copy.contactLabel}</label>
        <input id="f-reach" name="contact" type="text" autocomplete="email" required />
      </div>
      <div class="field">
        <label for="f-service">{copy.serviceLabel}</label>
        <select id="f-service" name="service">
          <option value="">{copy.notSure}</option>
          {serviceList.map((s) => <option value={s.id}>{s.name}</option>)}
        </select>
      </div>
      <div class="field">
        <label for="f-message">{copy.messageLabel}</label>
        <textarea id="f-message" name="message" rows="5" required></textarea>
      </div>
      <button class="btn btn-primary" type="submit">{copy.sendMessage}</button>
      <p class="status" id="form-status" role="status" aria-live="polite"></p>
    </form>
  </div>
</section>

<style>
  .contact { background: radial-gradient(circle at top left, rgba(43, 159, 217, 0.15), transparent 30%), linear-gradient(180deg, var(--ink) 0%, #0c1c2b 100%); color: var(--text-on-ink); padding-block: var(--section); }
  .layout { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: clamp(2.5rem, 7vw, 6rem); align-items: start; }
  .pitch { padding: clamp(1.4rem, 2vw, 1.8rem); background: rgba(255,255,255,0.02); border: 1px solid rgba(164, 184, 204, 0.18); border-radius: 1.25rem; }
  .eyebrow { margin-bottom: 0.9rem; font-size: var(--step--1); font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--gold); }
  h2 { font-size: var(--step-3); }
  .pitch p { margin-top: 1.25rem; font-size: var(--step-1); line-height: 1.5; color: var(--text-on-ink-muted); max-width: 30rem; }
  .channels { margin: 2.5rem 0 0; display: grid; gap: 1.25rem; }
  .channels dt { font-size: var(--step--1); color: var(--text-on-ink-muted); }
  .channels dd { margin: 0.15rem 0 0; font-size: var(--step-1); font-weight: 500; }
  .channels a { text-decoration: underline; text-underline-offset: 0.25em; }

  .form { display: grid; gap: 1.25rem; padding: clamp(1.4rem, 2.4vw, 2rem); background: rgba(10, 19, 28, 0.75); border: 1px solid rgba(164, 184, 204, 0.22); border-radius: 1.25rem; box-shadow: 0 18px 48px rgba(2, 8, 15, 0.22); }
  .field { display: grid; gap: 0.45rem; }
  label { font-weight: 600; font-size: var(--step--1); }
  input, select, textarea {
    width: 100%; font: inherit; color: var(--text-on-ink); background: rgba(23,40,58,0.9);
    border: 1px solid rgba(146, 173, 198, 0.35); border-radius: 0.9rem; padding: 0.85rem 0.95rem; min-height: 3rem; box-shadow: inset 0 1px 0 rgba(255,255,255,0.02);
  }
  select { appearance: none; background-image: linear-gradient(45deg, transparent 50%, currentColor 50%), linear-gradient(135deg, currentColor 50%, transparent 50%); background-position: calc(100% - 1.15rem) 50%, calc(100% - 0.8rem) 50%; background-size: 0.35rem 0.35rem; background-repeat: no-repeat; padding-right: 2.5rem; }
  textarea { resize: vertical; min-height: 8rem; }
  input:focus-visible, select:focus-visible, textarea:focus-visible { outline: 3px solid var(--gold); outline-offset: 1px; border-color: var(--gold); }
  input[aria-invalid='true'], textarea[aria-invalid='true'] { border-color: #f08a7c; }
  .form .btn { justify-self: start; }
  .status { min-height: 1.5rem; font-size: var(--step--1); color: var(--text-on-ink-muted); }
  .status[data-state='error'] { color: #f6a99d; }
  .status[data-state='ok'] { color: #9ad9b0; }

  @media (max-width: 860px) { .layout { grid-template-columns: 1fr; } .form .btn { justify-self: stretch; } }
</style>
