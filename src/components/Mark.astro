---
import { markViewBox, markBlue, markGold } from '../data/mark';
interface Props { class?: string; label?: string; }
const { class: className, label } = Astro.props;
---
<svg
  class={className}
  viewBox={markViewBox}
  xmlns="http://www.w3.org/2000/svg"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>
  <path class="mark-blue" fill="#29A9E2" fill-rule="evenodd" d={markBlue} />
  <path class="mark-gold" fill="#FFC20E" fill-rule="evenodd" d={markGold} />
</svg>
