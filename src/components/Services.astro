---
import { services } from '../data/site';
import { amharicServices, messages, type Language } from '../data/locales';
interface Props { language?: Language; }
const { language = 'en' } = Astro.props;
const copy = messages[language];
const serviceList = language === 'am' ? amharicServices : services;
---
<section class="services" id="services" aria-labelledby="services-title">
  <div class="container">
    <div class="intro">
      <h2 id="services-title">{copy.servicesTitle}</h2>
      <p>{copy.servicesIntro}</p>
    </div>

    <div class="list">
      {serviceList.map((s, index) => (
        <article class="service" id={s.id}>
          <div class="service-head">
            <span class="number">0{index + 1}</span>
            <span class="dot" aria-hidden="true"></span>
          </div>
          <h3>{s.name}</h3>
          <p class="summary">{s.situation}</p>
          <ul class="tags">
            {s.items.slice(0, 3).map((i) => <li>{i}</li>)}
          </ul>
          <a class="service-link" href="#contact" data-service={s.id}>
            {copy.askAbout.replace('{service}', s.short)}
          </a>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .services { padding-block: clamp(4.5rem, 8vw, 7rem); background: linear-gradient(180deg, #edf2f5 0%, #eef3f7 100%); }
  .intro { display: grid; gap: 1.25rem; max-width: 46rem; }
  .intro h2 { font-size: var(--step-3); }
  .intro p { font-size: var(--step-1); line-height: 1.5; color: var(--text-muted); }

  .list { margin-top: clamp(2.5rem, 5vw, 4rem); display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .service {
    display: grid; align-content: start; gap: 1rem; min-height: 18rem; padding: 1.5rem 1.5rem 1.35rem;
    background: rgba(255, 255, 255, 0.98); border: 1px solid rgba(19, 35, 52, 0.08);
    border-radius: 1.1rem; box-shadow: 0 10px 28px rgba(13, 24, 38, 0.06);
    border-top: 4px solid var(--blue);
  }
  .service:nth-child(2), .service:nth-child(3) { border-top-color: var(--gold); }
  .service-head { display: flex; align-items: center; justify-content: space-between; }
  .number { color: var(--blue-text); font-size: var(--step--1); font-weight: 700; letter-spacing: 0.08em; }
  .dot { width: 10px; height: 10px; border-radius: 50%; background: var(--blue); display: inline-block; }
  .service:nth-child(2) .dot, .service:nth-child(3) .dot { background: var(--gold); }
  .service h3 { margin-top: 0.2rem; font-size: clamp(1.5rem, 2vw, 2rem); line-height: 1.15; }
  .summary { margin: 0; color: var(--text); font-weight: 600; font-size: 1.02rem; line-height: 1.45; }
  .tags { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.25rem; }
  .tags li {
    padding: 0.42rem 0.7rem; background: #eef4f8; color: var(--text); border: 1px solid rgba(19, 35, 52, 0.06);
    border-radius: 999px; font-size: 0.78rem; font-weight: 600; letter-spacing: 0.01em;
  }
  .service-link {
    margin-top: auto; display: inline-flex; align-items: center; justify-content: center; min-height: 2.8rem;
    padding: 0.7rem 1rem; border-radius: 999px; background: #f8fafb; border: 1px solid rgba(19,35,52,0.08);
    color: var(--ink); font-weight: 700; text-decoration: none;
  }
  .service-link:hover { background: #eef4f8; }

  @media (max-width: 800px) { .service { min-height: 0; } }
  @media (max-width: 560px) { .list { grid-template-columns: 1fr; } .service { padding: 1.35rem; } }
</style>
